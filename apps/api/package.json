{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../web/.env.local src/index.ts",
    "start": "tsx --env-file-if-exists=../web/.env.local src/index.ts",
    "typecheck": "tsc --noEmit",
    "job:notify": "tsx --env-file=../web/.env.local src/jobs/cli.ts notify",
    "job:reminders": "tsx --env-file=../web/.env.local src/jobs/cli.ts reminders",
    "job:sweep": "tsx --env-file=../web/.env.local src/jobs/cli.ts sweep"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "@keiki/core": "workspace:*",
    "@supabase/supabase-js": "^2.114.0",
    "hono": "^4.10.3",
    "postgres": "^3.4.9",
    "stripe": "^22.6.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
