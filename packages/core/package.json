{
  "name": "@keiki/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "seed": "tsx --env-file=../../apps/web/.env.local scripts/seed.ts",
    "import:catalogue": "tsx --env-file=../../apps/web/.env.local scripts/import-catalogue.ts",
    "thunder": "tsx --env-file=../../apps/web/.env.local scripts/thunder.ts",
    "notify": "tsx --env-file=../../apps/web/.env.local scripts/jobs.ts notify",
    "reminders": "tsx --env-file=../../apps/web/.env.local scripts/jobs.ts reminders",
    "sweep": "tsx --env-file=../../apps/web/.env.local scripts/jobs.ts sweep",
    "verify:api": "tsx scripts/verify-api-parity.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.114.0",
    "postgres": "^3.4.9",
    "stripe": "^22.6.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
